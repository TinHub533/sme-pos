# Postgres-only config — copy to .env in this same directory:
#   docker compose --env-file tools/postgresql/.env -f tools/postgresql/docker-compose.yml up -d
#
# If you change these, update the matching SPRING_DATASOURCE_* values in the
# app stack's own env too (../../.env.example) — the backend connects with
# these same credentials.

POSTGRES_DB=smepos
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_HOST_PORT=5433
